# Copy to .env.local and fill in. Never commit real values.
# Variables WITHOUT the NEXT_PUBLIC_ prefix are server-only.

# --- App -------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Supabase (Phase 5) ----------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Bypasses RLS. Used only by src/server/sync and audited admin actions.
SUPABASE_SECRET_KEY=

# --- Token encryption (Phase 6) --------------------------------------
# 32 random bytes, base64. Generate: openssl rand -base64 32
# Use the SAME value in every environment that shares the database (local + Vercel),
# or tokens saved in one cannot be read in the other.
TOKEN_ENCRYPTION_KEY=
TOKEN_ENCRYPTION_KEY_VERSION=1

# --- Meta Marketing API (Phase 6) ------------------------------------
META_APP_ID=
# Used only to sign requests (appsecret_proof). Server-only.
META_APP_SECRET=
# Facebook Login for Business configuration id
META_LOGIN_CONFIG_ID=
META_GRAPH_API_VERSION=v25.0

# --- Scheduler (Phase 7) ---------------------------------------------
# Random string >= 16 chars. Vercel Cron sends it as "Authorization: Bearer <CRON_SECRET>".
CRON_SECRET=
